{
  "name": "presentkim/mapmanager",
  "description": "A simple map data manager plugin for axolotl-pm/PocketMine-MP (adds a filled map item)",
  "type": "project",
  "license": "LGPL-3.0-or-later",
  "require": {
    "php": "^8.4"
  },
  "require-dev": {
    "axolotl-pm/pocketmine-mp": "^5.51",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "ref\\api\\mapmanager\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ref\\api\\mapmanager\\tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
